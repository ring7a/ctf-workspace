# Challenge working data and originals are not committed
events/*/challenges/*/work/
events/*/challenges/*/untrusted/
# Python / tool noise
__pycache__/
*.pyc
.venv/
# Entire challenge tree (data + solve work) is untrusted and per-event
events/*/challenges/
.venv-tools/
# Rehearsal/practice solve artifacts (downloads + flags)
events/rehearsal-*/
# Per-event folders (challenge data, solve notes, flags) are never tracked.
events/*
!events/_TEMPLATE/
!events/_TEMPLATE/**
!events/README.md
# Generated slide deck — build locally via tools/build-deck.js, do not commit
docs/*.pptx
# MS Office lock/temp files
~$*
# Node build deps for the deck generator
node_modules/
package-lock.json
