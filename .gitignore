# Challenge working data and originals are not committed
events/*/challenges/*/work/
events/*/challenges/*/untrusted/
# Python / tool noise
__pycache__/
*.pyc
.venv/
# Entire challenge tree (data + solve work) is untrusted and per-event
events/*/challenges/
.venv-tools/
# Rehearsal/practice solve artifacts (downloads + flags)
events/rehearsal-*/
