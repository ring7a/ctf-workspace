{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Skill"
    ],
    "deny": [
      "Read(./**/untrusted/**)",
      "Bash(rm -rf /*)"
    ]
  },
  "env": {
    "CTF_WORKSPACE": "E:/ctf"
  }
}
